    key: "mBQkOWTgiJWr48ll9kZMSbT37MMGv4+6JQiDfqGlqZo="

ota:
  - platform: esphome
    password: "4e983c573c55185e6c6368546ba1a5af"

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

  manual_ip:
